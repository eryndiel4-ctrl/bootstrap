            exit 1
        fi
    fi
else
    # auto: attempt a Supervisor restart, but never mark provisioning failed
    # merely because the service is not controllable during this boot phase.
    restart_comfy || rc=$?
    if [[ "${rc:-0}" == "10" ]]; then
        echo "ℹ️ Automatic ComfyUI restart was skipped; Vast's Supervisor lifecycle will load the installed nodes."
    elif [[ "${rc:-0}" != "0" ]]; then
