    echo "ℹ️ RESTART_COMFY=false; leaving the currently running ComfyUI process alone."
elif [[ "$RESTART_COMFY" == "true" ]]; then
    unset rc
    restart_comfy || rc=$?
    if [[ "${rc:-0}" != "0" ]]; then
        if [[ "${rc:-0}" == "10" ]]; then
            echo "ℹ️ Automatic restart is unavailable; Supervisor is not controllable from this shell."
        else
            echo "❌ Setup files are installed, but ComfyUI restart/readiness failed."
