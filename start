#!/usr/bin/env bash
# ============================================================================
# Vast.ai Official ComfyUI Ephemeral Bootstrap
# Workflow: MiniMax H3 / Seed Hunter
#
# Designed for Vast.ai's official ComfyUI image (vastai/comfy), while retaining
# compatibility with manual execution inside a matching Vast.ai ComfyUI image.
#
# Intended use:
#   Set PROVISIONING_SCRIPT to this script's public/raw URL in the Vast.ai
#   official ComfyUI template, then create a fresh instance.
#
# Required environment variable:
#   CIVITAI_TOKEN  (or CIVITAI_API_TOKEN)
#
# Optional environment variables:
#   FORCE_REINSTALL=true          # Remove ONLY this script's managed nodes first
#   UPDATE_NODES=true             # Update existing managed git nodes to latest remote
#   INSTALL_IMPACT_MODELS=false   # Set true only when Impact Pack's SAM assets are wanted
#   RESTART_COMFY=auto            # auto/true/false; Vast uses Supervisor to manage ComfyUI
#   FRAME_INTERPOLATION_CUDA13=auto
#   READY_TIMEOUT=300             # Seconds to wait for the Vast ComfyUI workspace
#   DISK_RESERVE_GB=8             # Free-space safety margin for pip/git/temp files
#   ARIA2_SPLIT=8                 # Parallel pieces for large downloads when supported
#   ARIA2_CONNECTIONS=8           # Connections per server for aria2
#   CLEAN_PIP_CACHE=true          # Purge pip cache after dependency installation
#
# Vast.ai official ComfyUI defaults used by this script:
#   WORKSPACE=/workspace
#   COMFYUI_DIR=/workspace/ComfyUI
#   PYTHON=/venv/main/bin/python
#   ComfyUI internal port=18188 (Vast maps it externally as port 8188)
#   Supervisor service name=comfyui
#
# Optional pin file for reproducibility (pinned nodes use a non-shallow clone):
#   /workspace/comfyui-seed-hunter-node-pins.txt
#   Format: one "directory=commit-or-tag" per line, e.g.
#   rgthree-comfy=abc123...
# ============================================================================

set -Eeuo pipefail

# Vast writes instance/account environment variables to /etc/environment.
# Source it before resolving our defaults so a custom WORKSPACE is respected.
if [[ -f /etc/environment ]]; then
    # shellcheck disable=SC1091
    source /etc/environment
fi

# ------------------------------- Settings -----------------------------------
WORKSPACE="${WORKSPACE:-/workspace}"
COMFY_DIR="${COMFYUI_DIR:-${WORKSPACE}/ComfyUI}"
FORCE_REINSTALL="${FORCE_REINSTALL:-false}"
UPDATE_NODES="${UPDATE_NODES:-false}"
INSTALL_IMPACT_MODELS="${INSTALL_IMPACT_MODELS:-false}"
RESTART_COMFY="${RESTART_COMFY:-auto}"
FRAME_INTERPOLATION_CUDA13="${FRAME_INTERPOLATION_CUDA13:-auto}"
READY_TIMEOUT="${READY_TIMEOUT:-300}"
COMFY_PORT="${COMFY_PORT:-18188}"
DISK_RESERVE_GB="${DISK_RESERVE_GB:-8}"
ARIA2_SPLIT="${ARIA2_SPLIT:-8}"
ARIA2_CONNECTIONS="${ARIA2_CONNECTIONS:-8}"
CLEAN_PIP_CACHE="${CLEAN_PIP_CACHE:-true}"
LOG_FILE="${WORKSPACE}/setup.log"
COMFY_LOG="${WORKSPACE}/comfyui-bootstrap.log"
PIN_FILE="${WORKSPACE}/comfyui-seed-hunter-node-pins.txt"
MANIFEST_FILE="${WORKSPACE}/comfyui-seed-hunter-manifest.txt"
LOCK_DIR="${WORKSPACE}/.seed_hunter_setup.lock"

ORIGINAL_DIR="$(pwd)"
mkdir -p "$WORKSPACE"

# Log to both terminal and persistent workspace file.
exec > >(tee -a "$LOG_FILE") 2>&1

# ----------------------------- Error handling -------------------------------
on_error() {
    local exit_code=$?
    echo ""
    echo "❌ Setup aborted (exit code $exit_code at line ${BASH_LINENO[0]:-unknown})."
    echo "   See: $LOG_FILE"
    exit "$exit_code"
}
trap on_error ERR

cleanup_lock() {
    rm -rf "$LOCK_DIR"
}
trap cleanup_lock EXIT

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    echo "❌ Another Seed Hunter setup may already be running."
    echo "   Lock: $LOCK_DIR"
    exit 1
fi

# --------------------------- Required credentials ---------------------------
API_TOKEN="${CIVITAI_TOKEN:-${CIVITAI_API_TOKEN:-}}"
if [[ -z "$API_TOKEN" ]]; then
    echo "❌ CIVITAI_TOKEN/CIVITAI_API_TOKEN is not set."
    echo "   Add it to the Vast.ai template / Account Environment Variables before provisioning."
    exit 1
fi

# -------------------------- Utility functions --------------------------------
human_size() {
    numfmt --to=iec --suffix=B "$1" 2>/dev/null || printf '%s bytes\n' "$1"
}

file_size() {
    stat -c%s "$1" 2>/dev/null || stat -f%z "$1" 2>/dev/null || echo 0
}

append_failure() {
    FAILED_ITEMS+=("$1")
}

# Verify that a file satisfies both size and optional SHA-256 requirements.
verify_file() {
    local file="$1"
    local min_bytes="$2"
    local expected_sha256="${3:-}"
    local actual_size
    actual_size="$(file_size "$file")"

    if [[ ! -f "$file" ]]; then
        return 1
    fi

    if (( actual_size < min_bytes )); then
        echo "   ⚠️ File is too small: $(human_size "$actual_size") (minimum $(human_size "$min_bytes"))"
        return 1
    fi

    if [[ -n "$expected_sha256" ]]; then
        local actual_sha256
        actual_sha256="$(sha256sum "$file" | awk '{print $1}')"
        if [[ "${actual_sha256,,}" != "${expected_sha256,,}" ]]; then
            echo "   ❌ SHA-256 mismatch"
            echo "      expected: $expected_sha256"
            echo "      actual:   $actual_sha256"
            return 1
        fi
    fi

    return 0
}

validate_torch_environment() {
    local actual cuda_available torch_location
    actual="$($PYTHON_CMD -c 'import torch; print("cu" + torch.version.cuda.replace(".", "")) if torch.version.cuda else print("cpu")' 2>/dev/null || echo unknown)"
    cuda_available="$($PYTHON_CMD -c 'import torch; print(torch.cuda.is_available())' 2>/dev/null || echo unknown)"
    torch_location="$($PYTHON_CMD -c 'import torch, os; print(os.path.realpath(torch.__file__))' 2>/dev/null || echo unknown)"

    echo "✅ Active torch CUDA build: $actual"
    echo "✅ CUDA available: $cuda_available"
    echo "✅ Torch location: $torch_location"

    if [[ "$cuda_available" != "True" ]]; then
        echo "❌ PyTorch cannot access CUDA in the detected Vast.ai environment."
        return 1
    fi

    return 0
}

free_bytes() {
    df -P -B1 "$COMFY_DIR" | awk 'NR==2 {print $4}'
}

required_min_download_bytes() {
    local total=0 file min part part_size remaining
    while IFS='|' read -r file min; do
        [[ -z "$file" ]] && continue
        if [[ -f "$file" ]] && verify_file "$file" "$min" >/dev/null 2>&1; then
            continue
        fi
        part="$(dirname "$file")/.${file##*/}.part"
        part_size=0
        if [[ -f "$part" ]]; then
            part_size="$(file_size "$part")"
        fi
        remaining=$(( min > part_size ? min - part_size : 0 ))
        total=$(( total + remaining ))
    done <<EOF
$COMFY_DIR/models/checkpoints/dasiwa_minimax_h3.safetensors|${CIVITAI_MODEL_SIZE_BYTES:-5000000000}
$COMFY_DIR/models/text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors|15000000000
${COMFY_DIR}/user/default/workflows/Minimax_Seed_Hunter.json|${CIVITAI_WORKFLOW_SIZE_BYTES:-1024}
$COMFY_DIR/models/latent_upscale_models/minimax_h3_latent_upscaler_3d_conv_v1_fp16.safetensors|650000000
$COMFY_DIR/models/loras/minimax_h3_fl2v_turbo_silver_dareties_comfy_pruned_v1.safetensors|725000000
$COMFY_DIR/models/vae/minimax_h3_video_vae_int8_convrot.safetensors|3000000000
$COMFY_DIR/models/vae_approx/taeh3.safetensors|9000000
EOF
    if [[ "$INSTALL_IMPACT_MODELS" == "true" ]]; then
        total=$(( total + 500000000 ))
    fi
    printf '%s\n' "$total"
}

check_disk_space() {
    local free needed reserve
    free="$(free_bytes)"
    reserve=$(( DISK_RESERVE_GB * 1000000000 ))
    needed=$(( $(required_min_download_bytes) + reserve ))
    echo "💾 Free space on ComfyUI filesystem: $(human_size "$free")"
    echo "💾 Minimum remaining asset space + reserve: $(human_size "$needed")"
    if (( free < needed )); then
        echo "❌ Not enough free disk space for the planned asset bundle."
        echo "   Increase pod disk size or lower DISK_RESERVE_GB."
        return 1
    fi
}

# ------------------------- ComfyUI path discovery ----------------------------
find_comfy_dir() {
    local candidates=(
        "$COMFY_DIR"
        "${WORKSPACE}/ComfyUI"
    )
    local d
    for d in "${candidates[@]}"; do
        if [[ -d "$d" && -f "$d/main.py" ]]; then
            printf '%s\n' "$d"
            return 0
        fi
    done
    return 1
}

find_python() {
    local comfy_dir="$1"
    local candidates=()
    shopt -s nullglob
    candidates+=("/venv/main/bin/python")
    candidates+=("$comfy_dir"/.venv-cu*/bin/python)
    candidates+=("$comfy_dir"/.venv/bin/python)
    candidates+=("${WORKSPACE}/venv/bin/python")
    candidates+=("/usr/local/bin/python3")
    candidates+=("/usr/bin/python3")

    local p
    for p in "${candidates[@]}"; do
        if [[ -x "$p" ]]; then
            printf '%s\n' "$p"
            return 0
        fi
    done
    return 1
}

wait_for_comfy_workspace() {
    local elapsed=0
    local comfy_dir=""

    while (( elapsed < READY_TIMEOUT )); do
        if comfy_dir="$(find_comfy_dir 2>/dev/null)"; then
            COMFY_DIR="$comfy_dir"
            if PYTHON_CMD="$(find_python "$COMFY_DIR" 2>/dev/null)"; then
                echo "✅ ComfyUI workspace ready: $COMFY_DIR"
                echo "✅ Python detected: $PYTHON_CMD"
                return 0
            fi
        fi

        sleep 3
        elapsed=$((elapsed + 3))
        echo "⏳ Waiting for Vast.ai ComfyUI workspace... ${elapsed}s/${READY_TIMEOUT}s"
    done

    return 1
}


# ---------------------------- Initial checks ---------------------------------
echo ""
echo "==============================================================="
echo "🚀 MiniMax H3 / Seed Hunter Vast.ai setup"
echo "==============================================================="
echo ""
echo "Vast.ai official ComfyUI provisioning may still be completing."
wait_for_comfy_workspace || {
    echo "❌ Could not find a ready ComfyUI workspace."
    echo "   Expected: ${WORKSPACE}/ComfyUI"
    echo "   Increase READY_TIMEOUT if the image is still initializing."
    exit 1
}

if [[ ! -x "$PYTHON_CMD" ]]; then
    echo "❌ ComfyUI Python executable is not usable: $PYTHON_CMD"
    exit 1
fi

# Vast's official images provide uv; use it for all Python package operations.
UV_CMD="${UV_CMD:-uv}"
if ! command -v "$UV_CMD" >/dev/null 2>&1; then
    echo "❌ uv is not available in the Vast.ai official image."
    exit 1
fi
if ! "$UV_CMD" pip --help >/dev/null 2>&1; then
    echo "❌ uv's pip interface is not available."
    exit 1
fi
echo "✅ uv detected: $(command -v "$UV_CMD")"

PYTHON_BIN_DIR="$(dirname "$PYTHON_CMD")"
VENV_DIR="$(dirname "$PYTHON_BIN_DIR")"
if [[ -f "$VENV_DIR/bin/activate" ]]; then
    # shellcheck disable=SC1090
    source "$VENV_DIR/bin/activate"
    echo "✅ Activated ComfyUI venv: $VENV_DIR"
fi

# Use the image-provided uv pip interface with an explicit target interpreter.
uv_pip() {
    "$UV_CMD" pip "$@" --python "$PYTHON_CMD"
}

# Vast's official image owns the PyTorch/CUDA stack. Protect the image-baked
# torch family from custom-node installers by constraining already-installed
# core packages instead of replacing them with arbitrary resolver choices.
PIP_CONSTRAINT_FILE="${WORKSPACE}/.seed_hunter-vast-pip-constraints.txt"
: > "$PIP_CONSTRAINT_FILE"
for pkg in torch torchvision torchaudio triton xformers; do
    if installed_ver="$(uv_pip show "$pkg" 2>/dev/null | sed -n 's/^Version: //p' | head -n1)" && [[ -n "$installed_ver" ]]; then
        printf '%s==%s\n' "$pkg" "$installed_ver" >> "$PIP_CONSTRAINT_FILE"
    fi
done
export UV_CONSTRAINT="$PIP_CONSTRAINT_FILE"
echo "✅ Protecting image-baked core packages with uv constraint: $PIP_CONSTRAINT_FILE"

# ----------------------- System dependency bootstrap -------------------------
# Install host utilities only after Vast.ai's own workspace/bootstrap is ready,
# so apt activity cannot compete with the template's first-boot migration.
MISSING_PKGS=()
command -v git >/dev/null 2>&1 || MISSING_PKGS+=(git)
command -v curl >/dev/null 2>&1 || MISSING_PKGS+=(curl)
command -v wget >/dev/null 2>&1 || MISSING_PKGS+=(wget)
command -v aria2c >/dev/null 2>&1 || MISSING_PKGS+=(aria2)
command -v jq >/dev/null 2>&1 || MISSING_PKGS+=(jq)
command -v sha256sum >/dev/null 2>&1 || MISSING_PKGS+=(coreutils)
command -v numfmt >/dev/null 2>&1 || MISSING_PKGS+=(coreutils)

if ((${#MISSING_PKGS[@]})); then
    mapfile -t MISSING_PKGS < <(printf '%s\n' "${MISSING_PKGS[@]}" | sort -u)
    echo "📦 Installing missing system packages: ${MISSING_PKGS[*]}"
    apt-get update -qq
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${MISSING_PKGS[@]}" >/dev/null
fi

# Stop ComfyUI before modifying custom nodes or the shared Python environment.
# Respect RESTART_COMFY=false so an explicitly requested stopped/untouched service
# is not unexpectedly left running/stopped by this bootstrap.
COMFY_STOPPED_BY_SCRIPT=false
stop_comfy_for_setup() {
    if [[ "$RESTART_COMFY" == "false" ]]; then
        echo "ℹ️ RESTART_COMFY=false; leaving the current ComfyUI service untouched."
        return 0
    fi

    if ! command -v supervisorctl >/dev/null 2>&1; then
        echo "ℹ️ supervisorctl is unavailable; continuing without stopping ComfyUI first."
        return 0
    fi

    local status
    status="$(supervisorctl status comfyui 2>/dev/null || true)"
    if [[ "$status" == comfyui[[:space:]]RUNNING* ]]; then
        echo "🛑 Stopping ComfyUI before package/node changes..."
        if supervisorctl stop comfyui >/dev/null; then
            COMFY_STOPPED_BY_SCRIPT=true
            echo "✅ ComfyUI stopped."
        else
            echo "❌ Could not stop the ComfyUI Supervisor service."
            return 1
        fi
    else
        echo "ℹ️ ComfyUI service is not currently RUNNING; no stop needed."
    fi
}

stop_comfy_for_setup || exit 1

