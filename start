restart_comfy() {
    if ! command -v supervisorctl >/dev/null 2>&1; then
        echo "ℹ️ supervisorctl is unavailable; Vast will start/reload ComfyUI through its normal service lifecycle."
        return 10
    fi

    echo "🔄 Restarting Vast.ai ComfyUI service via Supervisor..."
    if supervisorctl restart comfyui; then
        echo "✅ Supervisor restarted the ComfyUI service."
        return 0
    fi

    echo "⚠️ supervisorctl restart failed; attempting start in case the service is stopped."
    if supervisorctl start comfyui; then
        echo "✅ Supervisor started the ComfyUI service."
        return 0
    fi

    echo "ℹ️ ComfyUI service is not restartable from the current provisioning phase; leaving it to Vast's normal lifecycle."
    return 10
}

