# Fetch the primary SHA-256 recorded by Civitai for a model version.
# This avoids hard-coding a Civitai hash that may be wrong for a particular
# version ID, while keeping the token out of the URL.
civitai_sha256() {
    local version_id="$1"
    local metadata
    metadata="$(curl -fsSL \
        --retry 3 --retry-all-errors --connect-timeout 20 --max-time 60 \
        -H "Authorization: Bearer $API_TOKEN" \
        "https://civitai.com/api/v1/model-versions/mini/$version_id")"

    jq -er '.hashes.SHA256 // empty' <<<"$metadata"
}

civitai_size() {
    local version_id="$1"
    curl -fsSL \
        --retry 3 --retry-all-errors --connect-timeout 20 --max-time 60 \
        -H "Authorization: Bearer $API_TOKEN" \
        "https://civitai.com/api/v1/model-versions/mini/$version_id" | \
        jq -er '.size // empty'
}

download_file() {
    local dest_dir="$1"
    local filename="$2"
    local url="$3"
    local min_bytes="$4"
    local expected_sha256="${5:-}"
    local auth_mode="${6:-none}"

    local dest="$dest_dir/$filename"
    local part="$dest_dir/.${filename}.part"
    local actual_size

    mkdir -p "$dest_dir"

    if [[ -f "$dest" ]]; then
        echo "🔎 Checking existing $filename..."
        if verify_file "$dest" "$min_bytes" "$expected_sha256"; then
            actual_size="$(file_size "$dest")"
            echo "✅ $filename already verified ($(human_size "$actual_size")); skipping."
            return 0
        fi

        echo "⚠️ Existing $filename failed validation; replacing it."
        rm -f "$dest"
    fi

    if [[ -f "$part" ]]; then
        echo "↻ Resuming $filename from $(human_size "$(file_size "$part")")..."
    else
        echo "⬇️ Downloading $filename..."
    fi

    local -a aria_args=(
        --allow-overwrite=true
        --auto-file-renaming=false
        --file-allocation=none
        --continue=true
        --max-tries=3
        --retry-wait=3
        --split="$ARIA2_SPLIT"
        --max-connection-per-server="$ARIA2_CONNECTIONS"
        --min-split-size=20M
        --connect-timeout=30
        --timeout=60
        --summary-interval=10
        --console-log-level=warn
        --dir="$dest_dir"
        --out=".${filename}.part"
    )

       if [[ "$auth_mode" == "civitai" ]]; then
        echo "🔐 Resolving Civitai signed download URL..."

        local resolved_url
        resolved_url="$(
            curl -fsS \
                --retry 3 \
                --retry-all-errors \
                --connect-timeout 30 \
                --max-time 60 \
                -H "Authorization: Bearer $API_TOKEN" \
                -D - \
                -o /dev/null \
                "$url" |
            awk 'BEGIN { IGNORECASE=1 }
                 /^location:/ {
                     sub(/\r$/, "", $0)
                     sub(/^[^:]*:[[:space:]]*/, "", $0)
                     print
                     exit
                 }'
        )"

        if [[ -z "$resolved_url" ]]; then
            echo "❌ Civitai did not return a signed download URL."
            rm -f "$part" "${part}.aria2"
            return 1
        fi

        echo "⬇️ Downloading Civitai asset with aria2c..."

        if ! aria2c "${aria_args[@]}" "$resolved_url"; then
            echo "⚠️ aria2c failed with the first signed URL; resolving a fresh URL..."

            resolved_url="$(
                curl -fsS \
                    --retry 3 \
                    --retry-all-errors \
                    --connect-timeout 30 \
                    --max-time 60 \
                    -H "Authorization: Bearer $API_TOKEN" \
                    -D - \
                    -o /dev/null \
                    "$url" |
                awk 'BEGIN { IGNORECASE=1 }
                     /^location:/ {
                         sub(/\r$/, "", $0)
                         sub(/^[^:]*:[[:space:]]*/, "", $0)
                         print
                         exit
                     }'
            )"

            if [[ -z "$resolved_url" ]] || ! aria2c "${aria_args[@]}" "$resolved_url"; then
                rm -f "$part" "${part}.aria2"
                echo "❌ Failed to download $filename from Civitai with aria2c."
                return 1
            fi
        fi
    else
        if ! aria2c "${aria_args[@]}" "$url"; then
            echo "⚠️ aria2c failed for $filename; falling back to wget..."
            rm -f "${part}.aria2"

            local -a wget_args=(
                --no-verbose
                --show-progress
                --continue
                --tries=3
                --timeout=60
                -O "$part"
            )

            if ! wget "${wget_args[@]}" "$url"; then
                rm -f "$part" "${part}.aria2"
                echo "❌ Failed to download $filename"
                return 1
            fi
        fi
    fi

    if ! verify_file "$part" "$min_bytes" "$expected_sha256"; then
        echo "❌ Downloaded $filename failed validation."
        rm -f "$part" "${part}.aria2"
        return 1
    fi

    actual_size="$(file_size "$part")"
    mv -f "$part" "$dest"
    rm -f "${part}.aria2"
    echo "✅ Downloaded and verified $filename ($(human_size "$actual_size"))"
}

