mkdir -p "$COMFY_DIR/custom_nodes"

# -------------------------- CUDA / GPU detection -----------------------------
# Use the CUDA version that the active PyTorch build was compiled for when
# choosing Python CUDA wheels. Also report the physical NVIDIA driver/GPU.
TORCH_CUDA_VERSION="$($PYTHON_CMD -c 'import torch; print(torch.version.cuda or "unknown")' 2>/dev/null || echo unknown)"
TORCH_VERSION="$($PYTHON_CMD -c 'import torch; print(torch.__version__)' 2>/dev/null || echo unknown)"
CUDA_AVAILABLE="$($PYTHON_CMD -c 'import torch; print(torch.cuda.is_available())' 2>/dev/null || echo unknown)"
GPU_NAME="$($PYTHON_CMD -c 'import torch; print(torch.cuda.get_device_name(0) if torch.cuda.is_available() else "none")' 2>/dev/null || echo unknown)"

echo "✅ PyTorch version: $TORCH_VERSION"
echo "✅ PyTorch CUDA build: $TORCH_CUDA_VERSION"
echo "✅ PyTorch CUDA available: $CUDA_AVAILABLE"
echo "✅ GPU: $GPU_NAME"

DRIVER_CUDA_VERSION="unknown"
if command -v nvidia-smi >/dev/null 2>&1; then
    DRIVER_CUDA_VERSION="$(nvidia-smi --query-gpu=cuda_version --format=csv,noheader 2>/dev/null | head -n1 || echo unknown)"
    echo "✅ NVIDIA driver-reported CUDA compatibility: $DRIVER_CUDA_VERSION"
fi

case "$TORCH_CUDA_VERSION" in
    13.*) CUDA_FAMILY="13x" ;;
    12.*) CUDA_FAMILY="12x" ;;
    11.*) CUDA_FAMILY="11x" ;;
    10.2) CUDA_FAMILY="102" ;;
    *) CUDA_FAMILY="unknown" ;;
esac

if [[ "$CUDA_AVAILABLE" != "True" ]]; then
    echo "❌ PyTorch cannot access a CUDA GPU in the detected environment."
    echo "   Check that you selected a compatible NVIDIA GPU/Vast.ai ComfyUI template."
    exit 1
fi

if [[ "$CUDA_FAMILY" == "unknown" ]]; then
    echo "❌ Unsupported/unknown PyTorch CUDA build: $TORCH_CUDA_VERSION"
    echo "   This bootstrap currently targets CUDA 12.x and CUDA 13.x."
    exit 1
fi

echo "✅ CUDA package family selected automatically: $CUDA_FAMILY"

validate_torch_environment || exit 1


# Read an optional pin file. Lines beginning with # are ignored.
get_pin() {
    local node_dir="$1"
    [[ -f "$PIN_FILE" ]] || return 0
    awk -F= -v key="$node_dir" '
        /^[[:space:]]*#/ { next }
        NF >= 2 {
            lhs=$1; gsub(/^[[:space:]]+|[[:space:]]+$/, "", lhs)
            rhs=$0; sub(/^[^=]*=/, "", rhs); gsub(/^[[:space:]]+|[[:space:]]+$/, "", rhs)
            if (lhs == key) { print rhs; exit }
        }
    ' "$PIN_FILE"
}

clone_or_update_node() {
    local repo="$1"
    local node_dir="$2"
    local pin="${3:-}"
    local dest="$COMFY_DIR/custom_nodes/$node_dir"

    if [[ "$FORCE_REINSTALL" == "true" && -e "$dest" ]]; then
        echo "🧹 Removing managed node: $node_dir"
        rm -rf "$dest"
    fi

    if [[ -e "$dest" && ! -d "$dest/.git" ]]; then
        echo "❌ $node_dir exists but is not a Git repository."
        echo "   Remove/rename that directory, then rerun the script."
        return 1
    fi

    if [[ ! -d "$dest/.git" ]]; then
        echo "⬇️ Cloning $node_dir..."
        # A pinned checkout needs history/refs available for arbitrary commit
        # or tag resolution. Use a non-shallow clone when a pin is requested.
        if [[ -n "$pin" ]]; then
            if ! git clone --filter=blob:none --recurse-submodules "$repo" "$dest"; then
                echo "❌ Failed to clone pinned-capable repository $node_dir"
                rm -rf "$dest"
                return 1
            fi
        elif ! git clone --depth 1 --recurse-submodules "$repo" "$dest"; then
            echo "❌ Failed to clone $node_dir"
            rm -rf "$dest"
            return 1
        fi
    elif [[ "$UPDATE_NODES" == "true" ]]; then
        echo "🔄 Updating $node_dir to current remote HEAD..."
        git -C "$dest" fetch --depth 1 origin
        local default_ref
        default_ref="$(git -C "$dest" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
        if [[ -n "$default_ref" ]]; then
            git -C "$dest" reset --hard "$default_ref"
        else
            echo "⚠️ Could not determine origin/HEAD for $node_dir; leaving current checkout unchanged."
        fi
    else
        echo "✅ $node_dir already exists; preserving current checkout."
    fi

    if [[ -n "$pin" ]]; then
        echo "📌 Pinning $node_dir to $pin..."

        # Existing shallow clones cannot reliably resolve arbitrary historical pins.
        if [[ "$(git -C "$dest" rev-parse --is-shallow-repository 2>/dev/null || echo false)" == "true" ]]; then
            echo "   -> Repository is shallow; fetching full history for pin resolution..."
            git -C "$dest" fetch --unshallow origin
        fi

        git -C "$dest" fetch --tags origin
        if ! git -C "$dest" rev-parse --verify --quiet "$pin^{commit}" >/dev/null; then
            git -C "$dest" fetch origin "$pin"
        fi
        git -C "$dest" checkout --detach "$pin"
        git -C "$dest" submodule update --init --recursive
    fi

    return 0
}

install_node_dependencies() {
    local node_dir="$1"
    local dest="$COMFY_DIR/custom_nodes/$node_dir"

    echo "🔧 Installing dependencies for $node_dir..."

    case "$node_dir" in
        ComfyUI-Frame-Interpolation)
            # The upstream install.py currently maps CUDA only through 12.x.
            # On CUDA 13, use the project's requirements-no-cupy.txt and install
            # CuPy's official CUDA-13 wheel explicitly. Current upstream runtime
            # code also dynamically discovers CUDA_HOME for its CuPy RawModule.
            # This avoids using the main-branch installer path that still lacks
            # CUDA-13 package mapping.
            if [[ "$FRAME_INTERPOLATION_CUDA13" == "disable" && "$CUDA_FAMILY" == "13x" ]]; then
                echo "⚠️ FRAME_INTERPOLATION_CUDA13=disable; skipping Frame Interpolation on CUDA 13."
                return 1
            fi

            echo "   -> Installing Frame Interpolation common requirements..."
            uv_pip install --no-cache -r "$dest/requirements-no-cupy.txt"

            echo "   -> Selecting CuPy package automatically for CUDA family: $CUDA_FAMILY"
            uv_pip uninstall -y \
                cupy cupy-wheel cupy-cuda102 cupy-cuda110 cupy-cuda111 cupy-cuda11x cupy-cuda12x cupy-cuda13x \
                >/dev/null 2>&1 || true

            case "$CUDA_FAMILY" in
                13x)
                    uv_pip install --no-cache "cupy-cuda13x"
                    ;;
                12x)
                    uv_pip install --no-cache "cupy-cuda12x"
                    ;;
                11x)
                    uv_pip install --no-cache "cupy-cuda11x"
                    ;;
                102)
                    uv_pip install --no-cache "cupy-cuda102"
                    ;;
                *)
                    echo "❌ No supported CuPy mapping for CUDA family $CUDA_FAMILY"
                    return 1
                    ;;
            esac

            # The project uses CUDA_HOME while compiling its RawModule kernels.
            # Prefer PyTorch's bundled CUDA component directory when present.
            TORCH_CUDA_LIB="$($PYTHON_CMD -c 'from pathlib import Path; import torch; p=Path(torch.__file__).parent / "lib"; print(p if (p / "libnvrtc-builtins.so").exists() or any(p.glob("*nvrtc-builtins*")) else "")' 2>/dev/null || true)"
            if [[ -n "$TORCH_CUDA_LIB" ]]; then
                export CUDA_HOME="$TORCH_CUDA_LIB"
                export CUDA_PATH="$TORCH_CUDA_LIB"
                echo "   -> CUDA_HOME set to PyTorch CUDA component directory: $CUDA_HOME"
            elif [[ -d /usr/local/cuda ]]; then
                export CUDA_HOME=/usr/local/cuda
                export CUDA_PATH=/usr/local/cuda
                echo "   -> CUDA_HOME set to: $CUDA_HOME"
            fi
            ;;

        ComfyUI-Impact-Pack)
            # Impact Pack has its own installer and can also provision SAM/ONNX
            # model assets. INSTALL_IMPACT_MODELS=false creates its documented
            # skip sentinel only for this run, then removes it.
            if [[ "$INSTALL_IMPACT_MODELS" == "true" ]]; then
                (cd "$dest" && \
                    COMFYUI_PATH="$COMFY_DIR" \
                    COMFYUI_MODEL_PATH="$COMFY_DIR/models" \
                    "$PYTHON_CMD" install.py)
            else
                touch "$COMFY_DIR/custom_nodes/skip_download_model"
                (cd "$dest" && \
                    COMFYUI_PATH="$COMFY_DIR" \
                    COMFYUI_MODEL_PATH="$COMFY_DIR/models" \
                    "$PYTHON_CMD" install.py)
                rm -f "$COMFY_DIR/custom_nodes/skip_download_model"
            fi
            ;;

        ComfyUI-Pixaroma)
            # Pixaroma declares imageio-ffmpeg in pyproject.toml.
            uv_pip install --no-cache -r "$dest/requirements.txt"
            ;;

        ComfyUI-H3-Prompt-IDE)
            echo "   ℹ️ H3 Prompt IDE has no Python dependencies; skipping package installation."
            ;;

        *)
            if [[ -f "$dest/requirements.txt" ]]; then
                uv_pip install --no-cache -r "$dest/requirements.txt"
            elif [[ -f "$dest/pyproject.toml" ]]; then
                # Some ComfyUI extensions use pyproject.toml without a separate
                # requirements.txt. Install them editable so declared deps land
                # in the ComfyUI venv.
                uv_pip install --no-cache -e "$dest"
            else
                echo "   ℹ️ No requirements.txt/pyproject.toml found; no pip install needed."
            fi
            ;;
    esac
}

verify_node_install() {
    local node_dir="$1"

    case "$node_dir" in
        ComfyUI-Frame-Interpolation)
            # Verify both the common runtime dependencies and the CUDA-specific
            # CuPy package family selected above.
            if ! "$PYTHON_CMD" -c 'import cupy, cv2, kornia' >/dev/null 2>&1; then
                echo "❌ Frame Interpolation dependency verification failed (cupy/cv2/kornia)."
                return 1
            fi

            CUPY_CUDA_VERSION="$($PYTHON_CMD -c 'import cupy; print(cupy.cuda.runtime.runtimeGetVersion())' 2>/dev/null || echo unknown)"
            echo "   -> CuPy CUDA runtime API version: $CUPY_CUDA_VERSION"

            case "$CUDA_FAMILY" in
                13x)
                    if ! "$PYTHON_CMD" -c 'import cupy; assert cupy.cuda.runtime.runtimeGetVersion() >= 13000' >/dev/null 2>&1; then
                        echo "❌ CUDA 13 was detected but CuPy is not a CUDA-13 build."
                        return 1
                    fi
                    ;;
                12x)
                    if ! "$PYTHON_CMD" -c 'import cupy; assert 12000 <= cupy.cuda.runtime.runtimeGetVersion() < 13000' >/dev/null 2>&1; then
                        echo "❌ CUDA 12 was detected but CuPy is not a CUDA-12 build."
                        return 1
                    fi
                    ;;
            esac
            ;;

        ComfyUI-Impact-Pack)
            if ! PYTHONPATH="$COMFY_DIR/custom_nodes/$node_dir/modules${PYTHONPATH:+:$PYTHONPATH}" \
                "$PYTHON_CMD" -c 'import impact.config' >/dev/null 2>&1; then
                echo "❌ Impact Pack import verification failed."
                return 1
            fi
            if [[ "$INSTALL_IMPACT_MODELS" == "true" && ! -f "$COMFY_DIR/models/sams/sam_vit_b_01ec64.pth" ]]; then
                echo "❌ Impact Pack SAM model was not found after installation."
                echo "   Expected: $COMFY_DIR/models/sams/sam_vit_b_01ec64.pth"
                return 1
            fi
            ;;

        ComfyUI-Pixaroma)
            if ! "$PYTHON_CMD" -c 'import imageio_ffmpeg' >/dev/null 2>&1; then
                echo "❌ Pixaroma dependency verification failed (imageio-ffmpeg)."
                return 1
            fi
            ;;
    esac

    return 0
}

